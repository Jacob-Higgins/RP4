@book{allenStudySpeciesSeparation1986,
  title = {A Study of Species Separation in Free Jet Expansions},
  author = {Allen, Jr., Gary A. and Koppenwallner, Georg and Leners, Kenneth H.},
  year = {1986},
  month = jan,
  volume = {2},
  pages = {66--75},
  urldate = {2025-04-02},
  abstract = {Gaseous species separation in rocket exhaust plumes is important for the prediction of the composition of gases impingement on spacecraft surfaces. In order to predict theoretically the species separation, a physical model based upon a 'freezing surface' was developed. This model assumes that, upstream from the freezing surface, continuum flow with uniform gas composition exists. At the freezing surface an instantaneous transition from continuum to free molecular flow is assumed. Particles leave the freezing surface with a velocity composed of the bulk velocity and the thermal velocity which is characterized by a Maxwellian distribution dependent on the species. For a flow field point outside of the freezing surface, the gas composition is determined by a line of sight technique.},
  keywords = {Fluid Mechanics and Heat Transfer,Free Jets,Freezing,Gas Composition,Jet Impingement,Rocket Engines,Rocket Exhaust,Spacecraft Contamination},
  annotation = {ADS Bibcode: 1986rgd..conf...66A}
}

