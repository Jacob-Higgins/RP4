}

@incollection{sharmaDSMCSimulationRocket2023,
  title = {{{DSMC Simulation}} of {{Rocket Plume Interactions}} with {{Extra-Terrestrial Regolith}}},
  booktitle = {Energy and {{Exergy}} for {{Sustainable}} and {{Clean Environment}}, {{Volume}} 2},
  author = {Sharma, Isha Mohan and Kadiyala, Vishnu Kiran and Malaikannan, G.},
